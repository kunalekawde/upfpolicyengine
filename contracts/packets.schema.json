{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UPF Demo Packets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "scenarioId", "packets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "$ref": "#/$defs/nonEmptyId" },
    "scenarioId": { "$ref": "#/$defs/nonEmptyId" },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packet" }
    },
    "adapterOutcomes": {
      "type": "array",
      "items": { "enum": ["SUCCESS", "DELAYED_SUCCESS", "TRANSIENT_FAILURE", "PERMANENT_FAILURE"] }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "delaysMicros"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "delaysMicros": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
        }
      }
    },
    "shutdownDeadlineMicros": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
  },
  "$defs": {
    "nonEmptyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teid", "qfi"],
      "properties": {
        "teid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "qfi": { "type": "integer", "minimum": 1, "maximum": 63 }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packetId", "sessionId", "ingress", "sourceIp", "destinationIp", "protocol", "sourcePort", "destinationPort", "payloadBytes", "arrivalTimeMicros"],
      "properties": {
        "packetId": { "$ref": "#/$defs/nonEmptyId" },
        "sessionId": { "$ref": "#/$defs/nonEmptyId" },
        "ingress": { "enum": ["N3", "N6"] },
        "tunnel": { "$ref": "#/$defs/tunnel" },
        "sourceIp": { "type": "string", "minLength": 2, "maxLength": 45 },
        "destinationIp": { "type": "string", "minLength": 2, "maxLength": 45 },
        "protocol": { "enum": ["TCP", "UDP", "ICMP", "ICMPV6"] },
        "sourcePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "destinationPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "payloadBytes": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "arrivalTimeMicros": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    }
  }
}
